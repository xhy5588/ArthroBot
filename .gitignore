# Generated robot files (URDF/USD builds, collision hulls, validation reports)
/build/
# Training runs, TensorBoard logs and recorded videos
/logs/
# Hydra run configs written by scripts/rsl_rl/ when overrides are given
/outputs/
# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
# Editors and OS
.vscode/
.idea/
.DS_Store
# Onshape API credentials (never commit)
**/onshape_credentials*
# Written next to the loaded checkpoint by scripts/rsl_rl/play.py
/checkpoints/*/exported/
/checkpoints/*/videos/
